# ==========================================
# BANCO DE DADOS (POSTGRES)
# ==========================================
POSTGRES_DB=nextflow_db
POSTGRES_USER=nextflow_user
POSTGRES_PASSWORD=sua_senha_secreta_aqui_123
POSTGRES_PORT=5432

# ==========================================
# BACKEND (.NET API)
# ==========================================
ASPNETCORE_ENVIRONMENT=Development

# Só homologação (compose.staging.yaml), atrás do proxy de borda: origens do front liberadas no CORS
CORS_ORIGINS=https://nextflow.zanni.tech

# ==========================================
# STORAGE (S3) — imagens de produtos
# ==========================================
# No dev todas têm padrão no compose.development.yaml; no staging as credenciais são obrigatórias.
# Admin do storage (painel web em http://localhost:9001). Senhas com no mínimo 8 caracteres
STORAGE_ROOT_USER=nextflow-admin
STORAGE_ROOT_PASSWORD=nextflow-admin-secret
# Usuário que a API usa (criado pelo storage/init.sh, acesso só aos buckets)
STORAGE_ACCESS_KEY=nextflow
STORAGE_SECRET_KEY=nextflow-secret
STORAGE_BUCKET_PUBLIC=nextflow-public
STORAGE_BUCKET_PRIVATE=nextflow-private
# Endereço que o navegador usa para abrir as imagens. Dev: http://localhost:9000 · VM: https://nextflow-s3.zanni.tech
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Chave de Assinatura do Token JWT (32+ caracteres)
# Deve bater com a variável que o base.yml injeta em JwtSettings__Key
JWT_KEY=uma_senha_super_secreta_e_longa_para_o_token_!@#

# ==========================================
# IA (Previsão de demanda)
# ==========================================
# Provedor de IA generativa usado para priorizar/explicar as recomendações (por enquanto: Gemini).
# Chave da API do Google AI Studio (https://aistudio.google.com/apikey). NUNCA commitar a chave real.
# Vazio = módulo funciona só com o cálculo determinístico (status "Concluída sem IA").
AI_PROVIDER=Gemini
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_SECONDS=60

# ==========================================
# SEED DE DEMONSTRAÇÃO (loja de doces e presentes, 36 meses)
# ==========================================
# Liga o seed nos compose (padrão true). Só roda em banco sem os dados de demonstração
SEED_DEMO_ENABLED=true
# "Hoje" da simulação (yyyy-MM-dd). Vazio = data atual; fixar deixa os dados reproduzíveis
SEED_DEMO_ANCHOR_DATE=
