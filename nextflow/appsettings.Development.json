{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=nextflow_db;Username=nextflow_user;Password=nextflow_password"
  },
  "JwtSettings": {
    "Key": "nextflow-chave-de-desenvolvimento-nao-use-fora-do-dev-0001"
  },
  "Seed": {
    "Demo": { "Enabled": true }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
