{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Key": "",
    "ExpirationHours": 8
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Storage": {
    "Endpoint": "",
    "PublicUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "Buckets": {
      "Public": "nextflow-public",
      "Private": "nextflow-private"
    }
  },
  "Seed": {
    "Demo": { "Enabled": false, "AnchorDate": null }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
